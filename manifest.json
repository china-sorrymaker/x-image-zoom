{
  "manifest_version": 3,
  "name": "X 图片放大镜",
  "version": "1.1.2",
  "description": "直接在 X 原生大图上滚轮缩放、拖拽查看，无额外弹层，无需重新加载图片。",
  "action": {
    "default_title": "X 图片放大镜：查看运行状态",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
